name: ci

on:
  push:
    branches:
    - main
  pull_request:
  workflow_dispatch:

defaults:
  run:
    shell: bash

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-24.04
    name: build
    # The default is 360 (i.e., 6 hours), which can be wasteful. See:
    # https://github.com/Cambridge-ICCS/green-ci/blob/b9e942d81e4d6536d69f3cfbffe28fa14b8ae381/README.md#time-limits
    timeout-minutes: 180
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # https://github.com/actions/checkout/issues/485
          persist-credentials: false
          submodules: true

      - uses: cachix/install-nix-action@13d8dd58da0234aa297dedd986986ccb8e7f3e24 # v31.11.1
        with:
          nix_path: nixpkgs=channel:nixos-unstable

      - name: Check Nix static semantics
        run: nix-instantiate

      - name: Build against upstream LLVM
        run: |
          # Some runners cannot reach tarballs.nixos.org. Seed the fixed-output
          # bootstrap paths from the regular Nix binary cache instead.
          nix --extra-experimental-features nix-command copy --from https://cache.nixos.org /nix/store/2pizl7lq4awa7p9bklr8037yh1sca0hg-bootstrap-tools.tar.xz
          nix --extra-experimental-features nix-command copy --from https://cache.nixos.org /nix/store/p9wzypb84a60ymqnhqza17ws0dvlyprg-busybox
          nix-shell -E '
            let p = import ./nixpkgs.nix;
            in p.mkShell {
              LLDB_INCLUDE = "${p.llvmPackages_latest.lldb.dev}/include";
              packages = [
                p.llvmPackages_latest.clang-tools
                p.llvmPackages_latest.llvm
                p.llvmPackages_latest.clang
                p.llvmPackages_latest.clang-unwrapped
                p.llvmPackages_latest.lldb
                p.cmake
                p.ninja
                p.pkg-config
                p.meson
                p.uv
                p.python312
                p.cacert
                p.zlib
              ];
            }
          ' --run '
            export UV_PROJECT_ENVIRONMENT="$CI_PROJECT_DIR/.venv-upstream-llvm"
            uv sync --dev
            export LLVM_CONFIG="$(command -v llvm-config)"
            clang_dir="$(dirname "$(command -v clang)")"
            uv run meson setup build-upstream-llvm \
              --buildtype=debugoptimized \
              -Dbracelet_llvm_extensions=false \
              -Dclang-dir="$clang_dir"
            uv run meson compile \
              -C build-upstream-llvm \
              bracelet-cc.sh \
              bracelet-edges \
              src/RuntimeFormat/BraceletRuntimeStructs_lldb.h \
              src/PointsTo/template_c.txt.inc \
              src/PointsTo/template_conservative.txt.inc \
              src/PointsTo/template_define_globals.txt.inc \
              src/PointsTo/template_prelude.txt.inc \
              src/PointsTo/template_svf.Makefile.inc
            uv run meson test \
              -C build-upstream-llvm \
              --no-rebuild \
              --print-errorlogs \
              --suite metadata
            run-clang-tidy \
              -p build-upstream-llvm \
              -quiet \
              -extra-arg=-resource-dir="$(clang -print-resource-dir)" \
              -extra-arg=-I"$(llvm-config --includedir)" \
              -extra-arg=-isystem"$LLDB_INCLUDE" \
              "^$CI_PROJECT_DIR/src/.*\\.cpp$"
          '
