set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)

set(VCPKG_CMAKE_SYSTEM_NAME Linux)

set(ENV{BRACELET_NODBG} ON)

set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE @INSTALL_PREFIX@/toolchain/bracelet-toolchain.cmake)

# Set build type
set(VCPKG_BUILD_TYPE release)

include("${CMAKE_CURRENT_LIST_DIR}/setup_sbom_env.cmake")
